# Database Utama (Simamba)
NUXT_DATABASE_HOST=localhost
NUXT_DATABASE_NAME=sql_website
NUXT_DATABASE_USER=sql_website
NUXT_DATABASE_PASSWORD=your_database_password
NUXT_DATABASE_PORT=3306

# Database ByZIS
NUXT_BYZIS_HOST=localhost
NUXT_BYZIS_USER=sql_byzis
NUXT_BYZIS_PASSWORD=your_byzis_password
NUXT_BYZIS_NAME=sql_byzis

NODE_ENV=development

# Session
NUXT_SESSION_PASSWORD=generate_a_32_character_random_string_here

# Google OAuth (nuxt-auth-utils)
NUXT_OAUTH_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google OAuth redirect URIs (daftar di Google Cloud Console):
# https://baznastangerangkab.or.id/api/auth/google/callback
# https://simamba.baznastangerangkab.or.id/api/auth/google/callback
# Jika auto-detect tidak bekerja, set redirect URI secara eksplisit di sini:
# NUXT_OAUTH_GOOGLE_REDIRECT_URL=https://baznastangerangkab.or.id/api/auth/google/callback

# Midtrans
NUXT_MIDTRANS_IS_PRODUCTION=false
NUXT_MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
NUXT_MIDTRANS_SERVER_KEY=your_midtrans_server_key_here

# CORS
NUXT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
NUXT_JWT_SECRET_BYZIS=your_jwt_secret_here

# Public API
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_DONASI_BASE=https://donasi.baznastangerangkab.or.id

# SIMBA API Config
NUXT_SIMBA_URL=https://demo-simba.baznas.or.id/
NUXT_SIMBA_ORG=9977200
NUXT_SIMBA_KEY=your_simba_api_key_here

# Upload Directory (WAJIB di-set di production!)
# Arahkan ke path absolut DI LUAR .output/ agar tidak terhapus saat build
# Contoh: NUXT_UPLOAD_DIR=/home/www/baznas/uploads
# Lalu tambahkan di Nginx: location /uploads { alias /home/www/baznas/uploads/; }
# Di development, biarkan kosong (otomatis ke public/uploads/)
NUXT_UPLOAD_DIR=
